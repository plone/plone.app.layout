
<nav id="portal-breadcrumbs"
     aria-label="breadcrumb"
     tal:define="
       breadcrumbs python:view.breadcrumbs;
     "
     i18n:attributes="aria-label"
     i18n:domain="plone"
>
  <div class="container">
    <ol class="breadcrumb"
        itemscope
        itemtype="https://schema.org/BreadcrumbList"
    >
      <li class="breadcrumb-item"
          itemprop="itemListElement"
          itemscope
          itemtype="https://schema.org/ListItem"
      >
        <a href="${python:view.navigation_root_url}"
           itemprop="item"
        >
          <span itemprop="name"
                i18n:translate="tabs_home"
          >Home</span>
        </a>
        <meta itemprop="position"
              content="1"
        />
      </li>
      <tal:loop tal:repeat="crumb breadcrumbs">
        <li class="breadcrumb-item"
            itemprop="itemListElement"
            itemscope
            itemtype="https://schema.org/ListItem"
            tal:condition="not: repeat/crumb/end"
        >
          <a href="${python:crumb['absolute_url']}"
             itemprop="item"
          >
            <span itemprop="name">${python:crumb['Title']}</span>
          </a>
          <meta itemprop="position"
                content="${python:repeat['crumb'].index +2}"
          />
        </li>
        <li class="breadcrumb-item active"
            aria-current="page"
            itemprop="itemListElement"
            itemscope
            itemtype="https://schema.org/ListItem"
            tal:condition="repeat/crumb/end"
        >
          <span itemprop="name">${python:crumb['Title']}</span>
          <meta itemprop="position"
                content="${python:repeat['crumb'].index +2}"
          />
        </li>
      </tal:loop>
    </ol>
  </div>
</nav>
